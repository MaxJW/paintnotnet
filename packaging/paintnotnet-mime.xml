<?xml version="1.0" encoding="UTF-8"?>
<!-- paint.net's .pdn images. shared-mime-info has no type for them, so paintnotnet defines one. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-paintnet">
    <comment>paint.net image</comment>
    <generic-icon name="image-x-generic"/>
    <magic priority="50">
      <match type="string" value="PDN3" offset="0"/>
    </magic>
    <glob pattern="*.pdn"/>
  </mime-type>
</mime-info>
